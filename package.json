{
  "name": "react-native-rich-flow",
  "version": "0.0.1",
  "description": "Rich-text flow models and UTF-16 selection utilities for React Native content renderers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tests",
    "tsconfig.json",
    "npm-shrinkwrap.json",
    "README.md",
    "PUBLISHING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tests/tsconfig.json",
    "check": "npm run build && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "react-native",
    "rich-text",
    "text-selection",
    "utf-16",
    "inline-attachments"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huamurui/react-native-rich-flow.git"
  },
  "homepage": "https://github.com/huamurui/react-native-rich-flow#readme",
  "bugs": {
    "url": "https://github.com/huamurui/react-native-rich-flow/issues"
  }
}
